# The agent service ONLY. No email provider credentials, review password or unsubscribe
# secret: the agent reaches the gate only through GATE_URL with GATE_API_TOKEN.

GATE_URL=http://gate:8000
# The same value as GATE_API_TOKEN in provider.env:
GATE_API_TOKEN=

AGENT_DB_PATH=/data/agent.db

# Lead sources and checks; leave empty to switch one off.
APOLLO_API_KEY=
BOUNCER_API_KEY=

# Database rules.
MAX_CONTACTS_PER_COMPANY=3
LAWFUL_BASES=legitimate_interest,consent,existing_customer
# The lawful basis recorded for contacts found through a data provider. Empty on purpose:
# decide and document it (for example a legitimate interests assessment) before using one.
DEFAULT_LAWFUL_BASIS=

# The agent loop. The key is for the Claude API; the agent is the only service that uses it
# (gate-public has its own, optional, in classifier.env).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium
AGENT_FALLBACKS=true
AGENT_MAX_ITERATIONS=40
# Optional web research (Claude's web search and fetch, about companies only), billed per
# use on top of tokens; capped per run.
AGENT_WEB_RESEARCH=false
AGENT_WEB_SEARCHES=5
AGENT_WEB_FETCHES=10
DAILY_NEW_COMPANIES=5
DAILY_RUN_HOUR_UTC=9
WATCH_INTERVAL_SECONDS=300
