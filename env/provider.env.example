# Internal gate service ONLY. Never give this file to the agent or to gate-public.

# The agent's token for POST /send-requests (the agent gets the same value in agent.env):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATE_API_TOKEN=
# The password for the /review page. People only; never give it to the agent.
GATE_REVIEW_PASSWORD=

# PROVIDER=smtp: any SMTP submission service.
PROVIDER=smtp
SMTP_HOST=smtp.example.net
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# PROVIDER=ses: Amazon SES. Credentials from the standard AWS variables or an instance role.
# SES_REGION=eu-west-1
# SES_CONFIGURATION_SET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# gate selftest: a mailbox you control, read over IMAP (TLS, port 993), or
# SELFTEST_VIA=inbound to catch it at the gate's own /inbound/ endpoints instead.
SELFTEST_VIA=imap
SELFTEST_TO=selftest@example.org
SELFTEST_IMAP_HOST=imap.example.org
SELFTEST_IMAP_PORT=993
SELFTEST_IMAP_USERNAME=
SELFTEST_IMAP_PASSWORD=
SELFTEST_IMAP_FOLDERS=INBOX,Junk
SELFTEST_TIMEOUT_SECONDS=180
