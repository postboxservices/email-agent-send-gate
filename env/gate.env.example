# Shared by both gate services (gate and gate-public). No email provider credentials here:
# they go in provider.env, which only the internal gate service receives.

# Safe defaults. DRY_RUN=false only takes effect after `gate selftest` passes.
DRY_RUN=true
REVIEW_MODE=true

# Who the messages are from. The agent cannot change any of this.
SENDER_NAME=Your Name
FROM_ADDRESS=you@outreach.example.com
REPLY_TO=you@example.com
COMPANY_NAME=Example Ltd
POSTAL_ADDRESS=1 Example Street, City, Postcode, Country
ALLOWED_SENDING_DOMAINS=outreach.example.com

# One-click unsubscribe. The public HTTPS address of gate-public, and a long random secret:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
UNSUBSCRIBE_BASE_URL=https://unsubscribe.example.com
UNSUBSCRIBE_SECRET=

# Inbound webhooks on gate-public. Leave empty to keep an endpoint switched off.
# Bearer token for /inbound/events and /inbound/raw (any provider, or a Postfix pipe):
INBOUND_TOKEN=
# Amazon SES: SNS topics allowed to post to /inbound/sns (comma separated ARNs):
INBOUND_SNS_TOPIC_ARNS=
# Optional Claude labels for replies the phrase rules cannot decide (needs env/classifier.env):
REPLY_CLASSIFIER=off
REPLY_CLASSIFIER_MODEL=claude-haiku-5-5

# Caps, per rolling 24 hours (the recipient cap counts until they reply).
CAP_PER_RECIPIENT_WITHOUT_REPLY=1
CAP_PER_RECIPIENT_DOMAIN_PER_DAY=3
CAP_PER_SENDING_DOMAIN_PER_DAY=50
CAP_TOTAL_PER_DAY=50
BLOCK_FREE_MAIL=true
